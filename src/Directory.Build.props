<Project>
  <!--
    Static analysis for this solution (closest C# equivalent of PHPStan / oxlint):
    - Compiler nullability + CS warnings fail the build
    - Meziantou.Analyzer adds design/security/perf rules
    - Microsoft.NET analyzers via the SDK (AnalysisLevel)

    Run locally:
      dotnet build src/Jellyfin.Plugin.HomeScreenSections/Jellyfin.Plugin.HomeScreenSections.csproj -c Release -p:JellyfinVersion=10.11.11
      dotnet test src/Jellyfin.Plugin.HomeScreenSections.Tests/Jellyfin.Plugin.HomeScreenSections.Tests.csproj -c Release
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- "Recommended" set, not maximum noise (All) -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <!-- NetAnalyzers NuGet package supplies the analyzers; do not also set EnableNETAnalyzers -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Fail CI / local build on analyzer + compiler warnings -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.302">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.140">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
